{
  "name": "gate-dex-trader",
  "version": "0.1.0",
  "private": true,
  "description": "Safety-first Solana new-token screener and paper trading framework.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/src/index.js",
    "scan": "tsx src/index.ts --once",
    "backtest": "tsx src/backtest/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.99.0",
    "better-sqlite3": "^12.4.1",
    "bs58": "^6.0.0",
    "dotenv": "^17.2.2",
    "pino": "^10.0.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
